# ==========================================================
#  HuilaConecta · Configuración del backend (Node.js)
#  Copia este archivo como ".env" y escribe tus datos.
# ==========================================================

# Puerto del servidor (el frontend espera el 8080)
PORT=8080

# Conexión a MySQL: los mismos datos de tu conexión en MySQL Workbench
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=escribe_aqui_tu_contraseña_de_mysql
DB_NAME=huilaconecta_db

# Zona horaria de las fechas (Colombia = -05:00)
DB_TIMEZONE=-05:00

# Carpeta donde están index.html, styles.css, etc. (relativa a backend/)
FRONTEND_DIR=..
